@page
@model SQLInjection.Pages.ItemsModel


<div class="m-5">
    <p>Search task</p>
    <form method="get">
        <div class="form-group">
            <label for="search">Search:</label>
            <input type="text" class="form-control" asp-for="@Model.SearchString">
        </div>
        <button type="submit" name="mode" value="@GetMode.SearchSafe" class="btn btn-primary">Search safely</button>
        <button type="submit" name="mode" value="@GetMode.SearchAdo" class="btn btn-danger">Search unsafely with ADO</button>
        <button type="submit" name="mode" value="@GetMode.SearchEf" class="btn btn-warning">Search unsafely with EfCore</button>
    </form>
</div>

<div class="m-5">
    <h1>My tasks</h1>
    <p>Add new task to the list</p>

    <form method="post">    
        <div class="form-group">
            <label for="title">Title:</label>
            <input type="text" class="form-control" id="title" name="title" required>
        </div>
        <div class="form-group">
            <label for="description">Description:</label>
            <textarea class="form-control" id="description" name="description" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Add task</button>
    </form>
</div>
@if(Model.Items.Count == 0)
{
    <div class="alert-info">
        <p>You don't have any tasks yet</p>
    </div>
}else
{
    <form method="post">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Status</th>
                    <th>&nbsp</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Description</td>
                        <td>@(item.IsCompleted ? "Completed" : "In Progress")</td>
                        <td><a asp-page="EditItem" asp-route-id="@item.Id">Edit</a> | <button class="btn btn-sm btn-danger" type="submit" asp-page-handler="delete" asp-route-id="@item.Id">Delete</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
}
